DIALOG estimate, tabtitle("Estimate")
BEGIN
  TEXT tx_multinet_k3 10 10 430 ., label("k3() - Phase 3 replicates (default 200)")
  EDIT ed_multinet_k3 450 10 610 ., nomem option(k3)
  TEXT tx_multinet_firstg 10 31 430 ., label("firstg() - initial gain (default 0.2)")
  EDIT ed_multinet_firstg 450 31 610 ., nomem option(firstg)
  TEXT tx_multinet_seed 10 52 185 ., label("seed()")
  EDIT ed_multinet_seed 200 52 150 ., nomem option(seed)
END

LIST netlist
BEGIN
	// populated at runtime by _nwdialog.ado
END

LIST lst_multinet_eff1
BEGIN
	behsim  (simX (beh))
	behegox  (egoX (beh))
	behaltx  (altX (beh))
	behegoplusalt  (egoPlusAltX (beh))
	egox  (egoX)
	altx  (altX)
	samex  (sameX)
	simx  (simX)
	netbeh:avgroupegox  (avGroupEgoX (beh))
	netbeh:totgroupegox  (totGroupEgoX (beh))
END

LIST lst_multinet_eff1_v
BEGIN
	behsim
	behegox
	behaltx
	behegoplusalt
	egox
	altx
	samex
	simx
	netbeh:avgroupegox
	netbeh:totgroupegox
END

