PROGRAM initialize
BEGIN
	put "_nwdialog nwsaom_multinet"
	stata hidden immediate
END

PROGRAM command
BEGIN
	put "nwsaom multinet"
	beginoptions
		put /program opt_part1
		put " "
		put /program opt_part2
		put " "
		put /program opt_part3
		put " "
		put /program opt_part4
		put " "
		put /program opt_part5
		put " "
		put /program opt_part6
		put " "
		put /program opt_part7
		put " "
		put /program opt_part8
		put " "
	endoptions
	stata
END

PROGRAM opt_part1
BEGIN
			if networks.cb_multinet_net1.isneq("") {
				optionarg /asis networks.cb_multinet_net1
			}
			if networks.cb_multinet_net2.isneq("") {
				optionarg /asis networks.cb_multinet_net2
			}
			if networks.cx_multinet_sym1 {
				put " sym1"
			}
			if networks.cx_multinet_sym2 {
				put " sym2"
			}
			if networks.ed_multinet_actormode.isneq("") {
