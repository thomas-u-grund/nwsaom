VERSION 10


SYNCHRONOUS_ONLY
INCLUDE _std_mlarge
DEFINE _dlgwd 1080
DEFINE _dlght 600
INCLUDE header

HELP hlp1, view("help nwsaom")
RESET res1

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG networks, tabtitle("Networks")
BEGIN
  TEXT tx_h0_1 10 10 1040 ., label("-- Two networks that change together on the same actors (the waves of each, same number, at least two) --")
  TEXT tx_multinet_net1 10 31 185 ., label("net1() - waves of network 1")
  COMBOBOX cb_multinet_net1 200 31 150 ., dropdown contents(netlist) append nomem option(net1)
  TEXT tx_multinet_net2 363 31 185 ., label("net2() - waves of network 2")
  COMBOBOX cb_multinet_net2 553 31 150 ., dropdown contents(netlist) append nomem option(net2)
  CHECKBOX cx_multinet_sym1 10 52 260 ., label("sym1 - network 1 is non-directed")
  CHECKBOX cx_multinet_sym2 275 52 260 ., label("sym2 - network 2 is non-directed")
  TEXT tx_multinet_actormode 10 73 430 ., label("actormode() - two-mode network: actor mode (1|2)")
  EDIT ed_multinet_actormode 450 73 610 ., nomem option(actormode)
  TEXT tx_multinet_tvcov 10 94 430 ., label("tvcov() - changing covariates a1 a2 a3")
  EDIT ed_multinet_tvcov 450 94 610 ., nomem option(tvcov)
  TEXT tx_multinet_eff1_t 10 115 1050 ., label("-- eff1() - effects within network 1 (default outdegree reciprocity) -- box next to the effect: variable / matrix / parameter after the colon")
  CHECKBOX cx_multinet_eff1_outdegree 10 136 260 ., label("outdegree (density)") default(1)
  CHECKBOX cx_multinet_eff1_reciprocity 275 136 260 ., label("reciprocity (recip)") default(1)
  CHECKBOX cx_multinet_eff1_transtrip 540 136 260 ., label("transtrip (transTrip)")
  CHECKBOX cx_multinet_eff1_cycle3 805 136 260 ., label("cycle3 (cycle3)")
  CHECKBOX cx_multinet_eff1_transmedtrip 10 157 260 ., label("transmedtrip (transMedTrip)")
  CHECKBOX cx_multinet_eff1_cycle4 275 157 260 ., label("cycle4 (cycle4)")
  CHECKBOX cx_multinet_eff1_indegpop 540 157 260 ., label("indegpop (inPop)")
  CHECKBOX cx_multinet_eff1_outact 805 157 260 ., label("outact (outAct)")
  COMBOBOX cb_multinet_eff1_1 10 178 215 ., dropdown contents(lst_multinet_eff1) values(lst_multinet_eff1_v) nomem
  EDIT ed_multinet_eff1_1a 230 178 115 ., nomem
  COMBOBOX cb_multinet_eff1_2 363 178 215 ., dropdown contents(lst_multinet_eff1) values(lst_multinet_eff1_v) nomem
  EDIT ed_multinet_eff1_2a 583 178 115 ., nomem
  COMBOBOX cb_multinet_eff1_3 716 178 215 ., dropdown contents(lst_multinet_eff1) values(lst_multinet_eff1_v) nomem
  EDIT ed_multinet_eff1_3a 936 178 115 ., nomem
  COMBOBOX cb_multinet_eff1_4 10 199 215 ., dropdown contents(lst_multinet_eff1) values(lst_multinet_eff1_v) nomem
  EDIT ed_multinet_eff1_4a 230 199 115 ., nomem
  TEXT tx_multinet_eff1_more 10 220 215 ., label("more tokens (typed)")
  EDIT ed_multinet_eff1_more 230 220 830 ., nomem
  TEXT tx_multinet_eff2_t 10 247 1050 ., label("-- eff2() - effects within network 2 (default outdegree reciprocity) -- box next to the effect: variable / matrix / parameter after the colon")
  CHECKBOX cx_multinet_eff2_outdegree 10 268 260 ., label("outdegree (density)") default(1)
  CHECKBOX cx_multinet_eff2_reciprocity 275 268 260 ., label("reciprocity (recip)") default(1)
  CHECKBOX cx_multinet_eff2_transtrip 540 268 260 ., label("transtrip (transTrip)")
  CHECKBOX cx_multinet_eff2_cycle3 805 268 260 ., label("cycle3 (cycle3)")
  CHECKBOX cx_multinet_eff2_transmedtrip 10 289 260 ., label("transmedtrip (transMedTrip)")
  CHECKBOX cx_multinet_eff2_cycle4 275 289 260 ., label("cycle4 (cycle4)")
  CHECKBOX cx_multinet_eff2_indegpop 540 289 260 ., label("indegpop (inPop)")
  CHECKBOX cx_multinet_eff2_outact 805 289 260 ., label("outact (outAct)")
  COMBOBOX cb_multinet_eff2_1 10 310 215 ., dropdown contents(lst_multinet_eff2) values(lst_multinet_eff2_v) nomem
  EDIT ed_multinet_eff2_1a 230 310 115 ., nomem
  COMBOBOX cb_multinet_eff2_2 363 310 215 ., dropdown contents(lst_multinet_eff2) values(lst_multinet_eff2_v) nomem
  EDIT ed_multinet_eff2_2a 583 310 115 ., nomem
  COMBOBOX cb_multinet_eff2_3 716 310 215 ., dropdown contents(lst_multinet_eff2) values(lst_multinet_eff2_v) nomem
  EDIT ed_multinet_eff2_3a 936 310 115 ., nomem
  COMBOBOX cb_multinet_eff2_4 10 331 215 ., dropdown contents(lst_multinet_eff2) values(lst_multinet_eff2_v) nomem
  EDIT ed_multinet_eff2_4a 230 331 115 ., nomem
  TEXT tx_multinet_eff2_more 10 352 215 ., label("more tokens (typed)")
  EDIT ed_multinet_eff2_more 230 352 830 ., nomem
  TEXT tx_n49_1 10 379 1050 ., label("cross1() - effects of network 1 that depend on the other network. Name[:var] for covariate versions (variable or tvcov stem),")
  TEXT tx_n50_1 10 400 1050 ., label("name:matrix for dyadic ones, name:# for a parameter. Native plugin only.")
END

