VERSION 10


SYNCHRONOUS_ONLY
INCLUDE _std_mlarge
DEFINE _dlgwd 1080
DEFINE _dlght 600
INCLUDE header

HELP hlp1, view("help nwsaom")
RESET res1

SCRIPT PREINIT
BEGIN
	program initialize
END

DIALOG waves, tabtitle("Waves")
BEGIN
  TEXT tx_nettype 10 10 120 ., label("Network type:")
  COMBOBOX cb_nettype 140 10 160 ., dropdownlist contents(l_nettype) values(l_nettype_v) onselchange(program type_apply) nomem
  TEXT tx_nettype_h 320 10 730 ., label("set from wave1; greys out (never hides) the options that do not apply to the type; auto switches all on")
  TEXT tx_h3_1 10 43 1040 ., label("-- Observed waves (a dependent network per wave; wave1()/wave2() OR waves()) --")
  TEXT tx_wave1 10 64 185 ., label("wave1()")
  COMBOBOX cb_wave1 200 64 150 ., dropdownlist contents(netlist) values(netlist) onselchangelist(netlist_a) nomem option(wave1)
  TEXT tx_wave2 363 64 185 ., label("wave2()")
  COMBOBOX cb_wave2 553 64 150 ., dropdown contents(netlist) nomem option(wave2)
  TEXT tx_waves 10 85 430 ., label("waves() - 2+ networks in time order")
  COMBOBOX cb_waves 450 85 610 ., dropdown contents(netlist) append nomem option(waves)
  TEXT tx_tvcov 10 106 430 ., label("tvcov() - changing covariates a1 a2 a3 | s1 s2 s3")
  EDIT ed_tvcov 450 106 610 ., nomem option(tvcov)
  TEXT tx_actormode 10 127 430 ., label("actormode() - two-mode actor mode (1|2)")
  EDIT ed_actormode 450 127 610 ., nomem tooltip("for: twomode") option(actormode)
  TEXT tx_h14_1 10 154 1040 ., label("-- Baseline: outdegree is required unless split into endowment + creation (reciprocity is optional) --")
  CHECKBOX cx_outdegree 10 175 260 ., label("outdegree (density)") tooltip("RSiena: density")
  CHECKBOX cx_reciprocity 275 175 260 ., label("reciprocity (recip)") tooltip("RSiena: recip")
  CHECKBOX cx_outdegreeendow 540 175 260 ., label("outdegreeendow")
  CHECKBOX cx_outdegreecreation 805 175 260 ., label("outdegreecreation")
  CHECKBOX cx_reciprocityendow 10 196 260 ., label("reciprocityendow")
  CHECKBOX cx_reciprocitycreation 275 196 260 ., label("reciprocitycreation")
  CHECKBOX cx_transtiesendow 540 196 260 ., label("transtiesendow")
  CHECKBOX cx_transtiescreation 805 196 260 ., label("transtiescreation")
  TEXT tx_endow 10 217 430 ., label("endow() - effects split into endowment")
  COMBOBOX cb_endow 450 217 610 ., dropdown contents(endow_list) append nomem tooltip("Name the same effect in endow() and creation(); covariate effects as altx:var") option(endow)
  TEXT tx_creation 10 238 430 ., label("creation() - the same effects, creation role")
  COMBOBOX cb_creation 450 238 610 ., dropdown contents(endow_list) append nomem option(creation)
  TEXT tx_h27_1 10 265 1040 ., label("-- Undirected networks --")
  CHECKBOX cx_symmetric 10 286 260 ., label("symmetric (non-directed network)")
  TEXT tx_symtype 10 307 430 ., label("symtype() - model type for undirected ties")
  COMBOBOX cb_symtype 450 307 610 ., dropdown contents(symtype_list) nomem tooltip("for: symmetric") option(symtype)
  TEXT tx_h31_1 10 334 1040 ., label("-- Degree-based effects (flags) --")
  CHECKBOX cx_indegpopularity 10 355 260 ., label("indegpopularity (inPopSqrt)") tooltip("RSiena: inPopSqrt")
  CHECKBOX cx_outpopularity 275 355 260 ., label("outpopularity (outPopSqrt)") tooltip("RSiena: outPopSqrt")
  CHECKBOX cx_outactivity 540 355 260 ., label("outactivity (outAct)") tooltip("RSiena: outAct")
  CHECKBOX cx_inactivity 805 355 260 ., label("inactivity (inActSqrt)") tooltip("RSiena: inActSqrt")
  CHECKBOX cx_inpop 10 376 260 ., label("inpop") tooltip("RSiena: inPop")
  CHECKBOX cx_outpop 275 376 260 ., label("outpop") tooltip("RSiena: outPop")
  CHECKBOX cx_inact 540 376 260 ., label("inact") tooltip("RSiena: inAct")
  CHECKBOX cx_outactsqrt 805 376 260 ., label("outactsqrt") tooltip("RSiena: outActSqrt")
  CHECKBOX cx_inpopc 10 397 260 ., label("inpopc (inPop.c)") tooltip("RSiena: inPop.c. native plugin only")
  CHECKBOX cx_outpopc 275 397 260 ., label("outpopc (outPop.c)") tooltip("RSiena: outPop.c. native plugin only")
  CHECKBOX cx_outactc 540 397 260 ., label("outactc (outAct.c)") tooltip("RSiena: outAct.c. native plugin only")
  CHECKBOX cx_inactc 805 397 260 ., label("inactc (inAct.c)") tooltip("RSiena: inAct.c. native plugin only")
  CHECKBOX cx_degplus 10 418 260 ., label("degplus") tooltip("RSiena: degPlus. native plugin only")
  CHECKBOX cx_degplusc 275 418 260 ., label("degplusc (degPlus.c)") tooltip("RSiena: degPlus.c. native plugin only")
  CHECKBOX cx_recipop 540 418 260 ., label("recipop") tooltip("RSiena: reciPop")
  CHECKBOX cx_recipopsqrt 805 418 260 ., label("recipopsqrt") tooltip("RSiena: reciPopSqrt")
  CHECKBOX cx_reciact 10 439 260 ., label("reciact")
  CHECKBOX cx_reciactsqrt 275 439 260 ., label("reciactsqrt")
  CHECKBOX cx_between 540 439 260 ., label("between") tooltip("RSiena: between")
  TEXT tx_h51_1 10 466 1040 ., label("-- Degree effects with a parameter (number or numlist) --")
  TEXT tx_outtrunc 10 487 185 ., label("outtrunc()")
  EDIT ed_outtrunc 200 487 150 ., nomem tooltip("RSiena: outTrunc") option(outtrunc)
  TEXT tx_outmore 363 487 185 ., label("outmore()")
  EDIT ed_outmore 553 487 150 ., nomem tooltip("RSiena: outMore") option(outmore)
  TEXT tx_outthreshold 716 487 185 ., label("outthreshold()")
  EDIT ed_outthreshold 906 487 150 ., nomem tooltip("RSiena: outThreshold") option(outthreshold)
END

