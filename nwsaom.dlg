  BUTTON bt_multinet 277 32 247 22, label("Several networks (multinet)...") onpush(program open_nwsaom_multinet)
  BUTTON bt_multiplex 532 32 247 22, label("Multiplex...") onpush(program open_nwsaom_multiplex)
  BUTTON bt_estat 787 32 247 22, label("Postestimation...") onpush(program open_nwsaom_estat)
  BUTTON bt_describe 22 60 247 22, label("Describe data...") onpush(program open_nwsaom_describe)
  BUTTON bt_meta 277 60 247 22, label("Meta-analysis...") onpush(program open_nwsaom_meta)
  BUTTON bt_simulate 532 60 247 22, label("Simulate...") onpush(program open_nwsaom_simulate)
END

