SCRIPT nettype_auto
BEGIN
	waves.cb_nettype.setvalue "auto"
	program type_apply
END

SCRIPT nettype_d
BEGIN
	waves.cb_nettype.setvalue "directed"
	program type_apply
END

SCRIPT nettype_u
BEGIN
	waves.cb_nettype.setvalue "undirected"
	program type_apply
END

SCRIPT nettype_b
BEGIN
	waves.cb_nettype.setvalue "two-mode"
	program type_apply
END

PROGRAM type_apply
BEGIN
	call script ty_auto
	if waves.cb_nettype.iseq("directed") {
		call script ty_d
	}
	if waves.cb_nettype.iseq("undirected") {
		call script ty_u
	}
	if waves.cb_nettype.iseq("two-mode") {
		call script ty_b
	}
END

