		put /program opt_part13
		put " "
	endoptions
	stata
END

PROGRAM opt_part1
BEGIN
			if waves.cb_wave1.isneq("") {
				optionarg /asis waves.cb_wave1
			}
			if waves.cb_wave2.isneq("") {
				optionarg /asis waves.cb_wave2
			}
			if waves.cb_waves.isneq("") {
				optionarg /asis waves.cb_waves
			}
			if waves.ed_tvcov.isneq("") {
				optionarg /asis waves.ed_tvcov
			}
			if waves.ed_actormode.isneq("") {
				optionarg /asis waves.ed_actormode
			}
			if waves.cx_outdegree {
				put " outdegree"
			}
			if waves.cx_reciprocity {
				put " reciprocity"
			}
			if waves.cx_outdegreeendow {
				put " outdegreeendow"
			}
			if waves.cx_outdegreecreation {
				put " outdegreecreation"
			}
			if waves.cx_reciprocityendow {
				put " reciprocityendow"
			}
			if waves.cx_reciprocitycreation {
				put " reciprocitycreation"
			}
			if waves.cx_transtiesendow {
				put " transtiesendow"
			}
			if waves.cx_transtiescreation {
				put " transtiescreation"
			}
			if waves.cb_endow.isneq("") {
				optionarg /asis waves.cb_endow
			}
			if waves.cb_creation.isneq("") {
				optionarg /asis waves.cb_creation
			}
			if waves.cx_symmetric {
				put " symmetric"
			}
			if waves.cb_symtype.isneq("") {
				optionarg /asis waves.cb_symtype
			}
			if waves.cx_indegpopularity {
				put " indegpopularity"
			}
			if waves.cx_outpopularity {
				put " outpopularity"
			}
			if waves.cx_outactivity {
				put " outactivity"
			}
			if waves.cx_inactivity {
				put " inactivity"
			}
			if waves.cx_inpop {
				put " inpop"
			}
			if waves.cx_outpop {
				put " outpop"
			}
			if waves.cx_inact {
				put " inact"
			}
			if waves.cx_outactsqrt {
				put " outactsqrt"
			}
			if waves.cx_inpopc {
				put " inpopc"
			}
			if waves.cx_outpopc {
				put " outpopc"
			}
			if waves.cx_outactc {
				put " outactc"
			}
			if waves.cx_inactc {
				put " inactc"
			}
			if waves.cx_degplus {
				put " degplus"
			}
			if waves.cx_degplusc {
				put " degplusc"
			}
			if waves.cx_recipop {
				put " recipop"
			}
			if waves.cx_recipopsqrt {
				put " recipopsqrt"
			}
END

