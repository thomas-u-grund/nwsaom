
. 
. * (a) fifteen separate fits of the same model (a first fit, then a restart fro
> m its estimates), stored
. local fits ""

. forvalues s = 1/15 {
  2.     quietly nwsaom, waves(class`s'_w1 class`s'_w2) outdegree reciprocity tr
> anstrip seed(1)
  3.     matrix b = e(b)
  4.     quietly nwsaom, waves(class`s'_w1 class`s'_w2) outdegree reciprocity tr
> anstrip seed(2) theta0(`=b[1,1]' `=b[1,2]' `=b[1,3]')
  5.     estimates store class`s'
  6.     display "class `s': max convergence ratio " %5.3f e(tconv_max)
  7.     local fits `fits' class`s'
  8. }
